{
  "rules": {
    ".read": false,
    ".write": false,
    "fornos": {
      "$fornoId": {
        ".read": "auth != null && auth.token.email_verified == true && auth.token.email == 'SEU_EMAIL_AUTORIZADO'",
        ".write": "auth != null && auth.token.email_verified == true && auth.token.email == 'SEU_EMAIL_ADMIN' && ($fornoId === 'pechini-01' || $fornoId === 'tubular-01' || $fornoId === 'mufla-01') && !newData.exists()",
        "historico": {
          ".indexOn": ["timestamp_ms"]
        }
      }
    }
  }
}
